{
  "version": 2,
  "installCommand": "npm install --include=dev",
  "buildCommand": "npx prisma generate && node --max-old-space-size=1024 ./node_modules/@nestjs/cli/bin/nest.js build",
  "functions": {
    "api/index.js": {
      "maxDuration": 30,
      "includeFiles": "dist/**,node_modules/.prisma/**,prisma/**"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api"
    }
  ]
}