# Database Configuration (Supabase Pooler)
DATABASE_URL="postgresql://postgres.[YOUR_PROJECT_REF]:[YOUR_DB_PASSWORD]@aws-1-ap-northeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[YOUR_PROJECT_REF]:[YOUR_DB_PASSWORD]@aws-1-ap-northeast-1.pooler.supabase.com:5432/postgres"

# Authentication
JWT_SECRET="YOUR_JWT_SECRET_HERE"

# AI Services (optional)
GOOGLE_AI_API_KEY="YOUR_GOOGLE_AI_API_KEY_HERE"
GROQ_API_KEY="YOUR_GROQ_API_KEY_HERE"

# Supabase
SUPABASE_URL="https://[YOUR_PROJECT_REF].supabase.co"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY_HERE"

# CORS
FRONTEND_URL="http://localhost:5173"
LOCALHOST_URL="http://localhost:5173"

# Server
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
