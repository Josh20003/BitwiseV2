generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Lesson {
  id                  Int                 @id @default(autoincrement())
  title               String
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  topics              Topic[]
  userLessons         UserLesson[]
  userLessonMasteries UserLessonMastery[]
}

model Topic {
  id             Int         @id @default(autoincrement())
  title          String
  lessonId       Int
  tags           String[]
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  contentText    String
  displayContent Json?
  lesson         Lesson      @relation(fields: [lessonId], references: [id])
  UserSkill      UserSkill[]
  userTopics     UserTopic[]
}

model UserSkill {
  id                Int      @id @default(autoincrement())
  userId            String
  topicId           Int
  level             Float    @default(0.5)
  mastery           Float    @default(0.5)
  attempts          Int      @default(0)
  correct           Int      @default(0)
  updatedAt         DateTime @updatedAt
  createdAt         DateTime @default(now())
  currentDifficulty String   @default("easy")
  topic             Topic    @relation(fields: [topicId], references: [id])

  @@unique([userId, topicId])
}

model Attempt {
  id          Int      @id @default(autoincrement())
  userId      String
  responses   Json?
  score       Int?
  feedback    String?
  createdAt   DateTime @default(now())
  questions   Json
  updatedAt   DateTime @updatedAt
  performance Json?
}

model UserLesson {
  id           Int       @id @default(autoincrement())
  userId       String
  lessonId     Int
  status       String    @default("not-started")
  progress     Float     @default(0.0)
  masteryScore Float?
  startedAt    DateTime?
  completedAt  DateTime?
  lastViewedAt DateTime  @updatedAt
  createdAt    DateTime  @default(now())
  lesson       Lesson    @relation(fields: [lessonId], references: [id])

  @@unique([userId, lessonId])
  @@index([userId])
}

model UserTopic {
  id            Int       @id @default(autoincrement())
  userId        String
  topicId       Int
  status        String    @default("not-started")
  viewCount     Int       @default(0)
  timeSpent     Int       @default(0)
  firstViewedAt DateTime?
  lastViewedAt  DateTime  @updatedAt
  completedAt   DateTime?
  createdAt     DateTime  @default(now())
  topic         Topic     @relation(fields: [topicId], references: [id])

  @@unique([userId, topicId])
  @@index([userId])
}

model UserLessonMastery {
  id               Int       @id @default(autoincrement())
  userId           String
  lessonId         Int
  masteryScore     Float     @default(0.5)
  assessmentCount  Int       @default(0)
  lastAssessmentAt DateTime?
  updatedAt        DateTime  @updatedAt
  createdAt        DateTime  @default(now())
  lesson           Lesson    @relation(fields: [lessonId], references: [id])

  @@unique([userId, lessonId])
  @@index([userId])
}

model BooleanExample {
  id              String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  title           String
  expression      String   @unique
  description     String
  learningFocus   String
  difficulty      String
  category        String
  variableCount   Int
  lawsUsed        String[]
  tags            String[]
  actualVariables String[]
  sortOrder       Int      @default(0)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now()) @updatedAt

  @@index([difficulty])
  @@index([category])
  @@index([variableCount])
  @@index([isActive])
}

// Module 2: Number System Converter Models
model NumberSystem {
  id             String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  name           String   @unique
  base           Int
  digits         String
  description    String?
  examples       String[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([base])
}

model ConversionExample {
  id             String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  sourceBase     Int
  targetBase     Int
  sourceValue    String
  targetValue    String
  steps          Json     // Array of conversion steps
  explanation    String
  difficulty     String
  category       String   // (binary, decimal, hex, etc)
  tags           String[]
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([sourceBase, targetBase])
  @@index([difficulty])
  @@index([category])
}

// Module 3: Binary Codes Models
model BinaryCode {
  id             String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  name           String   // (BCD, Gray Code, Hamming, etc)
  description    String
  encodingRules  Json     // Rules for encoding
  decodingRules  Json     // Rules for decoding
  examples       Json     // Array of {input: string, output: string}
  complexity     String   // (beginner, intermediate, advanced)
  tags           String[]
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([complexity])
}

// Module 4: Quiz and Assessment Models
model QuizQuestion {
  id             String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  topicId        Int
  content        String
  type           String   // (multiple-choice, true-false, short-answer)
  options        Json?    // For multiple choice
  correctAnswer  String
  explanation    String
  difficulty     String   // (easy, medium, hard)
  bloomLevel     String   // (remember, understand, apply, analyze, evaluate, create)
  estimatedTime  Int      // in seconds
  tags           String[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([topicId])
  @@index([difficulty])
  @@index([bloomLevel])
}

model QuizSession {
  id             String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  userId         String
  topicId        Int
  status         String   @default("in-progress")  // (in-progress, completed, abandoned)
  totalQuestions Int
  correctAnswers Int      @default(0)
  score          Float    @default(0.0)
  startedAt      DateTime @default(now())
  completedAt    DateTime?
  updatedAt      DateTime @updatedAt

  @@index([userId])
  @@index([topicId])
  @@index([status])
}

model QuizResponse {
  id             String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  sessionId      String
  questionId     String
  userAnswer     String
  isCorrect      Boolean
  timeSpent      Int      // in seconds
  feedback       String?
  createdAt      DateTime @default(now())

  @@index([sessionId])
  @@index([questionId])
}

// User Progress and Analytics Models
model UserProgress {
  id             String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  userId         String
  topicId        Int
  emaScore       Float    @default(0.5)    // Exponential Moving Average
  masteryLevel   Float    @default(0.0)    // 0-1 scale
  totalAttempts  Int      @default(0)
  correctCount   Int      @default(0)
  currentLevel   String   @default("novice")  // novice, beginner, intermediate, advanced, expert
  lastActivityAt DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([userId, topicId])
  @@index([userId])
  @@index([masteryLevel])
}

model LearningPath {
  id             String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  userId         String
  lessonId       Int
  recommendedAt  DateTime @default(now())
  startedAt      DateTime?
  completedAt    DateTime?
  status         String   @default("recommended") // (recommended, in-progress, completed, skipped)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userId])
  @@index([status])
}

// Bitwise Extended SDD Required Tables

model module_progress {
  id          String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  user_id     String
  module_id   Int
  completed   Boolean   @default(false)
  completedAt DateTime?

  @@unique([user_id, module_id])
  @@index([user_id])
}

model quiz_results {
  id          String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  user_id     String
  topic       String
  score       Float
  quizDate    DateTime @default(now())
  answersJson Json

  @@index([user_id])
  @@index([topic])
}

model ema_mastery {
  id         String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  user_id    String
  topic      String
  currentEMA Float    @default(0.0)
  updatedAt  DateTime @updatedAt

  @@unique([user_id, topic])
  @@index([user_id])
}

model user_streaks {
  id            String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  user_id       String   @unique
  currentStreak Int      @default(0)
  bestStreak    Int      @default(0)
  lastUpdated   DateTime @updatedAt

  @@index([user_id])
}

model calculator_history {
  id         String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  user_id    String
  mode       String   // BINARY, BOOLEAN, COMPLEMENT, CONVERTER
  input      String
  result     String
  createdAt  DateTime @default(now())

  @@index([user_id])
}
